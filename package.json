{
  "name": "maison-lekki",
  "version": "0.1.0",
  "private": true,
  "description": "Config-driven Next.js template for WhatsApp-first businesses. Food mode (multi-concept restaurants): maison-lekki (default), napoleon. Store mode (clothing, retail + wholesale): rr-retail.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/lib/*.test.ts",
    "dev:napoleon": "SKIN=napoleon next dev",
    "build:napoleon": "SKIN=napoleon next build",
    "dev:rr-retail": "SKIN=rr-retail next dev",
    "build:rr-retail": "SKIN=rr-retail next build"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "motion": "^12.43.0",
    "next": "^15.5.28",
    "papaparse": "^5.7.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
